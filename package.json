{
  "name": "coach-merche-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:login": "supabase login",
    "db:link": "supabase link --project-ref olcqupciiqaifgybfidf",
    "db:status": "supabase migration list --linked",
    "db:push:dry": "supabase db push --linked --dry-run",
    "db:push": "supabase db push --linked",
    "db:push:seed": "supabase db push --linked --include-seed",
    "db:types": "supabase gen types typescript --linked > src/types/database.generated.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
