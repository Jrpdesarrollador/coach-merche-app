# Supabase (proyecto Coach Merche)
# Dashboard → Project Settings → Data API / API Keys
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Zona horaria de referencia (España)
VITE_APP_TIMEZONE=Europe/Madrid

# Push notifications PWA (opcional — Fase 13)
# Generar par de claves VAPID; la pública va aquí, la privada solo en Supabase Edge Functions
# VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
