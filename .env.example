# Supabase (proyecto Coach Merche)
# Dashboard → Project Settings → Data API / API Keys
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Clave pública del cliente (anon JWT eyJ... o publishable sb_publishable_...)
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# VITE_SUPABASE_PUBLISHABLE_KEY=  # alias opcional de VITE_SUPABASE_ANON_KEY

# Zona horaria de referencia (España)
VITE_APP_TIMEZONE=Europe/Madrid

# URL pública de la app (solo documentación — la app usa window.location.origin)
# Producción: https://coach-merche-app.vercel.app
# VITE_APP_URL=https://coach-merche-app.vercel.app

# Push notifications PWA — clave pública VAPID (misma que VAPID_PUBLIC_KEY en Supabase)
# Generar: npx web-push generate-vapid-keys
# Vercel: Project → Settings → Environment Variables → Production + Preview
# VITE_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
